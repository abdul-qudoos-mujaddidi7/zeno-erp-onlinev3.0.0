<div class="toolbar no-print"><a class="btn btn-outline-primary" href="/smart-super-admin/invoice/edit/{{record.id}}">Edit invoice</a><button class="btn btn-primary" type="button" data-print>{{t 'Print'}}</button><a class="btn btn-outline-primary" href="/smart-super-admin/invoices/{{record.subscription_id}}">{{t 'Back'}}</a></div>
<section class="workspace-card invoice-sheet"><div class="invoice-heading"><div><h2>{{record.invoice_number}}</h2><p>{{subscription.org_name}} · {{subscription.plan_name}}</p></div>{{statusBadge record.invoice_status}}</div><div class="invoice-totals"><div>Total<strong>{{formatCurrency record.total_amount record.currency}}</strong></div><div>Paid<strong>{{formatCurrency record.paid_amount record.currency}}</strong></div><div>Balance<strong>{{formatCurrency record.balance record.currency}}</strong></div></div>{{> record}}<h2>{{t 'Features'}}</h2><ul>{{#each features}}<li>{{name}}: {{value}} {{unit}}</li>{{/each}}</ul></section>{{> payments}}
