<section class="index-page" aria-label="{{t tableTitle}}"><div class="index-panel">
  <header class="index-toolbar">
    <div class="index-toolbar-actions">{{#if createUrl}}<a class="btn btn-primary action-btn" href="{{createUrl}}"><i class="bi bi-plus-lg" aria-hidden="true"></i>{{t 'New'}}</a>{{/if}}<span class="index-record-count"><i class="bi bi-list-ul" aria-hidden="true"></i>{{t 'Records'}} <strong>{{total}}</strong></span></div>
    <form method="get" class="index-toolbar-main no-print">
      <label class="filter-search"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">{{t 'Search'}}</span><input name="q" type="search" value="{{query.q}}" maxlength="120" placeholder="{{t 'Search'}}"></label>
      {{#if query.type}}{{#unless errorLogs}}<input type="hidden" name="type" value="{{query.type}}">{{/unless}}{{/if}}{{#if query.status}}{{#unless commandList}}<input type="hidden" name="status" value="{{query.status}}">{{/unless}}{{/if}}
      {{#if filterEnabled}}<label class="index-filter-field"><span>{{t 'Type / status'}}</span><input class="form-control" name="filter" value="{{query.filter}}" maxlength="255"></label>{{/if}}
      {{#if errorLogs}}<label class="index-filter-field"><span>{{t 'Log type'}}</span><input class="form-control" name="type" value="{{query.type}}" maxlength="50"></label>{{/if}}
      {{#if commandList}}<label class="index-filter-field"><span>{{t 'Status'}}</span><input class="form-control" name="status" value="{{query.status}}" maxlength="50"></label>{{/if}}
      <button class="btn btn-outline-primary action-btn" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i>{{t 'Apply'}}</button>
    </form>
  </header>
  {{#if errorLogs}}<div class="index-extra-actions no-print"><form method="post" action="/smart-super-admin/error-logs/clear" data-confirm="Delete the selected log entries?"><select class="form-select" name="action" aria-label="Clear logs"><option value="clear_only_logs">Clear ordinary logs</option><option value="clear_all_logs">Clear all error logs</option></select><button class="btn btn-outline-danger action-btn" type="submit"><i class="bi bi-trash" aria-hidden="true"></i>Clear</button></form></div>{{/if}}
  {{#if syncLogs}}<div class="index-extra-actions no-print"><form method="post" action="/smart-super-admin/list/sync_logs" data-confirm="Clear all sync logs?"><input type="hidden" name="action" value="clear_logs"><button class="btn btn-outline-danger action-btn" type="submit"><i class="bi bi-trash" aria-hidden="true"></i>Clear sync logs</button></form></div>{{/if}}
  <div class="index-content"><div class="table-responsive data-table-wrap mobile-cards" tabindex="0" role="region" aria-label="{{t tableTitle}}"><table class="table smart-table data-table"><caption class="visually-hidden">{{t tableTitle}}</caption>
    <thead><tr>{{#each columns}}<th scope="col" {{#if sorted}}aria-sort="{{ariaSort}}"{{/if}}>{{#if url}}<a href="{{url}}">{{label}}<i class="bi {{#if sorted}}{{#if ascending}}bi-arrow-up{{else}}bi-arrow-down{{/if}}{{else}}bi-arrow-down-up{{/if}} sort-icon" aria-hidden="true"></i></a>{{else}}{{label}}{{/if}}</th>{{/each}}<th scope="col">{{t 'Actions'}}</th></tr></thead>
    <tbody>{{#each rows}}<tr>{{#each cells}}<td data-label="{{label}}">{{#if image}}<img class="record-image" src="{{image}}" alt="Record image" loading="lazy">{{else}}{{#if badge}}{{statusBadge value}}{{else}}<span class="cell-value" title="{{value}}">{{truncate value 180}}</span>{{/if}}{{/if}}</td>{{/each}}<td data-label="{{t 'Actions'}}"><div class="row-actions">{{#if detailUrl}}<a class="btn btn-outline-primary row-action" href="{{detailUrl}}" title="{{t 'Details'}}"><i class="bi bi-arrow-up-right" aria-hidden="true"></i><span class="visually-hidden">{{t 'Details'}}</span></a>{{/if}}{{#each actions}}<a class="btn btn-outline-primary row-action row-action-text" href="{{url}}">{{t label}}</a>{{/each}}</div></td></tr>{{else}}<tr><td colspan="100"><div class="index-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>{{t 'No matching records.'}}</strong><span>{{t 'Try another search or filter.'}}</span></div></td></tr>{{/each}}</tbody>
  </table></div></div>
  <footer class="index-footer">{{> pagination}}</footer>
</div></section>
