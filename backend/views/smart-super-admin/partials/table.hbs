<section class="workspace-card">
<form method="get" class="toolbar no-print"><label>{{t 'Search'}}<input class="form-control" name="q" value="{{query.q}}" maxlength="120"></label>{{#if query.type}}<input type="hidden" name="type" value="{{query.type}}">{{/if}}{{#if query.status}}<input type="hidden" name="status" value="{{query.status}}">{{/if}}{{#if filterEnabled}}<label>Type / status<input class="form-control" name="filter" value="{{query.filter}}" maxlength="255"></label>{{/if}}<button class="btn btn-outline-primary" type="submit">{{t 'Apply'}}</button><label>Per page<select class="form-select" data-page-limit>{{#each limits}}<option value="{{url}}" {{#if selected}}selected{{/if}}>{{limit}}</option>{{/each}}</select></label></form>
<div class="toolbar"><span>{{t 'Records'}}: {{total}}</span>{{#if createUrl}}<a class="btn btn-primary" href="{{createUrl}}">{{t 'New'}}</a>{{/if}}</div>
<div class="table-responsive"><table class="table smart-table"><caption class="visually-hidden">{{t tableTitle}}</caption><thead><tr>{{#each columns}}<th scope="col">{{#if url}}<a href="{{url}}">{{label}}</a>{{else}}{{label}}{{/if}}</th>{{/each}}<th scope="col">{{t 'Details'}}</th></tr></thead>
<tbody>{{#each rows}}<tr>{{#each cells}}<td>{{#if image}}<img class="record-image" src="{{image}}" alt="Record image" loading="lazy">{{else}}<span class="cell-value">{{truncate value 180}}</span>{{/if}}</td>{{/each}}<td><div class="row-actions">{{#if detailUrl}}<a class="btn btn-outline-primary" href="{{detailUrl}}">{{t 'Details'}}</a>{{/if}}{{#each actions}}<a class="btn btn-outline-primary" href="{{url}}">{{t label}}</a>{{/each}}</div></td></tr>{{else}}<tr><td colspan="100">No matching records.</td></tr>{{/each}}</tbody></table></div>
{{> pagination}}
</section>
