<section class="index-page" aria-label="{{t tableTitle}}"><div class="index-panel">
  <header class="index-toolbar index-toolbar--table">
    <div class="index-toolbar-actions">{{#if createUrl}}<a class="btn btn-primary action-btn" href="{{createUrl}}"><i class="bi bi-plus-lg" aria-hidden="true"></i>{{t 'New'}}</a>{{/if}}<span class="index-record-count"><i class="bi bi-list-ul" aria-hidden="true"></i>{{t 'Records'}} <strong>{{total}}</strong></span></div>
    <form method="get" class="index-toolbar-main no-print" data-filter-form data-error-message="{{t 'Could not refresh results. Please try again.'}}">
      <div class="filter-search" data-filter-search>
        <i class="bi bi-search filter-search__icon" aria-hidden="true"></i>
        <label class="visually-hidden" for="index-search">{{t 'Search'}}</label>
        <input id="index-search" class="filter-search__input" name="q" type="search" value="{{query.q}}" maxlength="120" placeholder="{{t 'Search'}}" autocomplete="off" data-filter-input>
        <button type="button" class="search-clear" data-filter-clear aria-label="{{t 'Clear search'}}" title="{{t 'Clear search'}}" {{#unless query.q}}hidden{{/unless}}><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        {{#if (any filterEnabled dateFilter.enabled)}}<button type="button" class="filter-toggle{{#if (any query.filter query.from query.to)}} is-active{{/if}}" data-filter-toggle aria-label="{{t 'Filter'}}" title="{{t 'Filter'}}" aria-expanded="false" aria-controls="index-filter-panel"><i class="bi bi-sliders2" aria-hidden="true"></i></button>{{/if}}
      </div>
      {{#if query.type}}<input type="hidden" name="type" value="{{query.type}}">{{/if}}{{#if query.status}}<input type="hidden" name="status" value="{{query.status}}">{{/if}}
      {{#if (any filterEnabled dateFilter.enabled)}}<div class="filter-panel" id="index-filter-panel" data-filter-panel hidden>
        <span class="filter-panel__arrow" aria-hidden="true"></span>
        <header class="filter-panel__header">
          <div class="filter-panel__title"><span class="filter-panel__title-icon"><i class="bi bi-sliders2" aria-hidden="true"></i></span><div><strong>{{t 'Filter'}}</strong><small>{{t 'Choose the options you need'}}</small></div></div>
          <button type="button" class="filter-panel__close" data-filter-close aria-label="{{t 'Close'}}" title="{{t 'Close'}}"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </header>
        <div class="filter-panel__body"><div class="filter-panel__fields">
          {{#if filterEnabled}}<label class="filter-field"><span class="filter-field__label">{{t 'Type / status'}}</span><input class="form-control" name="filter" value="{{query.filter}}" maxlength="255"></label>{{/if}}
          {{#if dateFilter.enabled}}<label class="filter-field"><span class="filter-field__label">{{t 'From'}} · {{dateFilter.label}}</span><input class="form-control" type="datetime-local" name="from" value="{{dateFilter.from}}"></label><label class="filter-field"><span class="filter-field__label">{{t 'To'}} · {{dateFilter.label}}</span><input class="form-control" type="datetime-local" name="to" value="{{dateFilter.to}}"></label>{{/if}}
        </div></div>
        <footer class="filter-panel__footer">
          <button type="button" class="filter-reset" data-filter-reset><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>{{t 'Reset'}}</button>
          <button type="submit" class="filter-apply"><i class="bi bi-check2" aria-hidden="true"></i>{{t 'Apply'}}</button>
        </footer>
      </div>{{/if}}
      <span class="filter-status" data-filter-status role="status" aria-live="polite" hidden></span>
    </form>
  </header>
  <div class="index-content"><div class="table-responsive data-table-wrap mobile-cards" tabindex="0" role="region" aria-label="{{t tableTitle}}"><table class="table smart-table data-table"><caption class="visually-hidden">{{t tableTitle}}</caption>
    <thead><tr>{{#each columns}}<th scope="col" {{#if sorted}}aria-sort="{{ariaSort}}"{{/if}}>{{#if url}}<a href="{{url}}">{{label}}<i class="bi {{#if sorted}}{{#if ascending}}bi-arrow-up{{else}}bi-arrow-down{{/if}}{{else}}bi-arrow-down-up{{/if}} sort-icon" aria-hidden="true"></i></a>{{else}}{{label}}{{/if}}</th>{{/each}}<th scope="col">{{t 'Actions'}}</th></tr></thead>
    <tbody>{{#each rows}}<tr class="{{#if detailUrl}}row-clickable {{/if}}{{#if inactive}}row-inactive{{/if}}" {{#if detailUrl}}data-row-url="{{detailUrl}}"{{/if}}>{{#each cells}}<td data-label="{{label}}">{{#if image}}<img class="record-image" src="{{image}}" alt="Record image" loading="lazy">{{else}}{{#if badge}}{{statusBadge value}}{{else}}<span class="cell-value" title="{{value}}">{{truncate value 180}}</span>{{/if}}{{/if}}</td>{{/each}}<td data-label="{{t 'Actions'}}"><details class="row-action-menu" data-row-menu><summary class="btn btn-outline-primary row-action" aria-label="{{t 'Row actions'}}" title="{{t 'Row actions'}}"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></summary><div class="row-action-menu-items">{{#if detailUrl}}<a class="row-action-menu-item" href="{{detailUrl}}">{{t 'Details'}}</a>{{/if}}{{#each actions}}<a class="row-action-menu-item" href="{{url}}">{{t label}}</a>{{/each}}</div></details></td></tr>{{else}}<tr><td colspan="100"><div class="index-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>{{t 'No matching records.'}}</strong><span>{{t 'Try another search or filter.'}}</span></div></td></tr>{{/each}}</tbody>
  </table></div></div>
  <footer class="index-footer">{{> pagination}}</footer>
</div></section>
