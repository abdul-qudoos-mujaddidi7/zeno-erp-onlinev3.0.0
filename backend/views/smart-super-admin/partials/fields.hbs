<div class="form-grid">{{#each fields}}<div class="form-field {{#if textarea}}wide{{/if}}"><label for="field-{{name}}">{{label}}</label>
{{#if textarea}}<textarea class="form-control" id="field-{{name}}" name="{{name}}" maxlength="20000" rows="4" {{#if rtl}}dir="rtl"{{/if}}>{{value}}</textarea>
{{else}}{{#if select}}<select class="form-select" id="field-{{name}}" name="{{name}}"><option value="">—</option>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
{{else}}<input class="form-control" id="field-{{name}}" name="{{name}}" type="{{inputType}}" value="{{value}}" {{#if required}}required{{/if}} {{#if rtl}}dir="rtl"{{/if}} {{#if (eq inputType 'number')}}step="0.000001" min="0"{{else}}maxlength="255"{{/if}}>{{/if}}{{/if}}</div>{{/each}}</div>
