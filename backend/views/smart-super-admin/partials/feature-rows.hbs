<section class="feature-editor" data-feature-editor><h2>{{t 'Features'}}</h2><div class="toolbar"><select class="form-select" data-feature-picker aria-label="Feature">{{#each allFeatures}}<option value="{{id}}">{{label}}</option>{{/each}}</select><button type="button" class="btn btn-outline-primary" data-feature-add>{{t 'Add feature'}}</button>{{#if (eq config.path 'subscription')}}<button type="button" class="btn btn-outline-primary" data-plan-features>Load plan features</button>{{/if}}</div>
<div data-feature-rows>{{#each assigned}}<div class="feature-row" data-feature-id="{{feature_id}}"><strong>{{name}}</strong><input type="hidden" name="feature_id[]" value="{{feature_id}}"><label>Value<input class="form-control" name="feature_value[]" value="{{value}}" maxlength="20000"></label><label>Unit<input class="form-control" name="feature_unit[]" value="{{unit}}" maxlength="50"></label>{{#if (eq ../config.path 'subscription')}}<label>Used<input class="form-control" value="{{used_value}}" readonly></label>{{/if}}<button class="btn btn-outline-danger" type="button" data-feature-remove>{{t 'Remove'}}</button></div>{{/each}}</div><p class="muted" data-feature-status role="status"></p></section>
