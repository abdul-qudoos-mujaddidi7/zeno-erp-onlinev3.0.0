<header class="smart-topbar"><div class="topbar-context"><button type="button" data-sidebar-toggle aria-controls="smart-sidebar" aria-expanded="false" aria-label="Open navigation"><i class="bi bi-list" aria-hidden="true"></i></button><span class="org-context">{{orgName}}</span>{{#if orgId}}<a href="/smart-super-admin/select-org/0">{{t 'All organizations'}}</a>{{/if}}</div>
<div class="topbar-tools"><form method="post" action="/smart-super-admin/language"><label for="smart-language">{{t 'Language'}}</label><select class="form-select" id="smart-language" name="language">{{#each languages}}<option value="{{code}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button class="btn btn-outline-primary" type="submit">{{t 'Apply'}}</button></form><span>{{userName}}</span></div></header>
