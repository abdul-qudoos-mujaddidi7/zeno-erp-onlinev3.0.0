<aside id="smart-sidebar" class="smart-sidebar" aria-label="{{t 'Navigation'}}">
  <div class="sidebar-shell">
    <div class="sidebar-brand"><a class="brand-main" href="/smart-super-admin" aria-label="Smart Super Admin"><img src="/img/logo.png" alt="ZenoERP"><small>Smart Super Admin</small></a><button type="button" class="sidebar-collapse-button" data-sidebar-collapse aria-controls="smart-sidebar" aria-expanded="true" aria-label="{{t 'Collapse sidebar'}}" data-expand-label="{{t 'Expand sidebar'}}" data-collapse-label="{{t 'Collapse sidebar'}}" title="{{t 'Collapse sidebar'}}"><i class="bi bi-list" aria-hidden="true"></i></button><button type="button" data-sidebar-close aria-label="{{t 'Close navigation'}}"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    <div class="sidebar-menu"><nav aria-label="Smart Super Admin">{{#each navigation}}<a href="{{url}}" class="{{#if active}}active{{/if}}" aria-label="{{t label}}" title="{{t label}}" {{#if active}}aria-current="page"{{/if}}><i class="bi {{icon}}" aria-hidden="true"></i><span class="sidebar-label">{{t label}}</span></a>{{/each}}</nav>
      <details class="record-menu" {{#if recordsActive}}open{{/if}}><summary title="{{t 'Records'}}" aria-label="{{t 'Records'}}"><i class="bi bi-grid" aria-hidden="true"></i><span class="sidebar-label">{{t 'Records'}}</span><i class="bi bi-chevron-down sidebar-chevron" aria-hidden="true"></i></summary><nav aria-label="{{t 'Records'}}">{{#each recordNavigation}}<a href="{{url}}" class="{{#if active}}active{{/if}}" title="{{label}}" aria-label="{{label}}" {{#if active}}aria-current="page"{{/if}}><i class="bi bi-table" aria-hidden="true"></i><span class="sidebar-label">{{label}}</span></a>{{/each}}</nav></details>
    </div>
    <details class="sidebar-profile"><summary title="{{userName}}"><span class="user-avatar" aria-hidden="true">{{userInitial}}</span><span class="user-meta"><strong>{{userName}}</strong><small>Smart Super Admin</small></span><i class="bi bi-chevron-up profile-chevron" aria-hidden="true"></i><span class="visually-hidden">{{t 'Preferences'}}</span></summary><div class="sidebar-profile-menu"><form method="post" action="/smart-super-admin/language"><label for="smart-language">{{t 'Language'}}</label><select class="form-select" id="smart-language" name="language">{{#each languages}}<option value="{{code}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button class="btn btn-outline-primary" type="submit">{{t 'Apply'}}</button></form></div></details>
  </div>
</aside>
<button type="button" class="sidebar-backdrop" data-sidebar-backdrop hidden aria-label="{{t 'Close navigation'}}"></button>
