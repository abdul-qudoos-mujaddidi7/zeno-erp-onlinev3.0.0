<header class="index-toolbar"><div class="index-toolbar-actions"><a class="btn btn-outline-primary action-btn" href="/smart-super-admin/organization-list/id/DESC/0/20/1"><i class="bi bi-list-ul" aria-hidden="true"></i>{{t 'Organization List'}}</a><span class="index-record-count">{{t 'Organizations'}} <strong>{{total}}</strong></span></div><div class="index-toolbar-main">{{> org-selector}}</div></header>
<div class="index-statistics"><i class="bi bi-building" aria-hidden="true"></i><span>{{t 'Current organization'}}</span><strong>{{orgName}}</strong><a href="/smart-super-admin/select-org/0">{{t 'All organizations'}}</a></div>
<div class="index-grid-content"><div class="organization-grid">{{#each organizations}}<article class="organization-card"><div class="organization-card-heading"><span class="organization-icon"><i class="bi bi-building" aria-hidden="true"></i></span><span class="muted">#{{id}} · {{type}}</span></div><h2>{{name}}</h2><p class="muted"><i class="bi bi-calendar3" aria-hidden="true"></i> {{formatDate created_at 'display'}}</p><div class="organization-card-actions"><a class="btn btn-primary action-btn" href="/smart-super-admin/select-org/{{id}}"><i class="bi bi-check2-circle" aria-hidden="true"></i>{{t 'Select'}}</a><a class="btn btn-outline-primary action-btn" href="/smart-super-admin/list/users/id/DESC/{{id}}/20/1"><i class="bi bi-people" aria-hidden="true"></i>{{t 'Users'}}</a></div></article>{{else}}<div class="index-empty-state"><i class="bi bi-building" aria-hidden="true"></i><strong>{{t 'No organizations found.'}}</strong></div>{{/each}}</div></div>
