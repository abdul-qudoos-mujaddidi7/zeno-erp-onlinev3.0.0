{{> org-selector}}<div class="toolbar"><span>{{t 'Organizations'}}: {{total}}</span><a class="btn btn-outline-primary" href="/smart-super-admin/organization-list/id/DESC/0/20/1">{{t 'Details'}}</a></div>
<div class="organization-grid">{{#each organizations}}<article class="workspace-card"><span class="muted">#{{id}} · {{type}}</span><h2>{{name}}</h2><p class="muted">{{formatDate created_at 'display'}}</p><div class="row-actions"><a class="btn btn-primary" href="/smart-super-admin/select-org/{{id}}">{{t 'Select'}}</a><a class="btn btn-outline-primary" href="/smart-super-admin/list/users/id/DESC/{{id}}/20/1">{{t 'Users'}}</a></div></article>{{else}}<p>No organizations found.</p>{{/each}}</div>
