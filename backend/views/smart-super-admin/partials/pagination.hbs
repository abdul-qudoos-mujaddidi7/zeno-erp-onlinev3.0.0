<nav class="smart-pagination" aria-label="Pagination"><span>{{t 'Page'}} {{pagination.current}} / {{pagination.total}}</span><div>{{#if pagination.previous}}<a class="btn btn-outline-primary" href="{{pagination.previous}}">{{t 'Previous'}}</a>{{/if}}{{#each pagination.pages}}<a class="btn {{#if active}}btn-primary{{else}}btn-outline-primary{{/if}}" href="{{url}}" {{#if active}}aria-current="page"{{/if}}>{{number}}</a>{{/each}}{{#if pagination.next}}<a class="btn btn-outline-primary" href="{{pagination.next}}">{{t 'Next'}}</a>{{/if}}</div></nav>
