<nav class="smart-pagination pagination-shell" aria-label="{{t 'Pagination'}}">
  <div class="pagination-info">{{#if limits}}<label>{{t 'Rows'}}<select class="form-select" data-page-limit>{{#each limits}}<option value="{{url}}" {{#if selected}}selected{{/if}}>{{limit}}</option>{{/each}}</select></label>{{/if}}{{#if rowEnd}}<span><strong>{{rowStart}}–{{rowEnd}}</strong> / {{total}}</span>{{/if}}<span>{{t 'Page'}} {{pagination.current}} / {{pagination.total}}</span></div>
  <div class="pagination-controls">{{#if pagination.previous}}<a class="btn btn-outline-primary" href="{{pagination.previous}}" aria-label="{{t 'Previous'}}"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>{{/if}}{{#each pagination.pages}}<a class="btn {{#if active}}btn-primary{{else}}btn-outline-primary{{/if}}" href="{{url}}" {{#if active}}aria-current="page"{{/if}}>{{number}}</a>{{/each}}{{#if pagination.next}}<a class="btn btn-outline-primary" href="{{pagination.next}}" aria-label="{{t 'Next'}}"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>{{/if}}</div>
</nav>
