<form method="post" action="{{action}}" class="workspace-card"><input type="hidden" name="{{idField}}" value="{{#if record.id}}{{record.id}}{{else}}0{{/if}}">{{> fields}}{{#if featuresEnabled}}{{> feature-rows}}{{/if}}<div class="form-actions"><button class="btn btn-primary" type="submit">{{t 'Save'}}</button><a class="btn btn-outline-primary" href="{{backUrl}}">{{t 'Back'}}</a></div></form>
