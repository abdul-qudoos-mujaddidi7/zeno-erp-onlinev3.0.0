<form method="get" class="toolbar"><label>Log type<input class="form-control" name="type" value="{{query.type}}" maxlength="50"></label><button class="btn btn-outline-primary" type="submit">{{t 'Apply'}}</button></form><form method="post" action="/smart-super-admin/error-logs/clear" class="toolbar" data-confirm="Delete the selected log entries?"><select class="form-select" name="action" aria-label="Clear logs"><option value="clear_only_logs">Clear ordinary logs</option><option value="clear_all_logs">Clear all error logs</option></select><button class="btn btn-outline-danger" type="submit">Clear</button></form>{{> table}}
