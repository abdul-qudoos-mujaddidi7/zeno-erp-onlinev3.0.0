<section class="workspace-card">{{> record}}</section>{{#if changes}}<section class="workspace-card"><h2>Changes</h2><div class="table-responsive"><table class="table"><thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead><tbody>{{#each changes}}<tr><td>{{name}}</td><td><pre>{{old}}</pre></td><td><pre>{{updated}}</pre></td></tr>{{/each}}</tbody></table></div></section>{{/if}}{{#each related}}<section class="workspace-card"><h2>{{title}}</h2>{{#each rows}}<dl class="record-details">{{#each this}}<div><dt>{{label}}</dt><dd><pre>{{value}}</pre></dd></div>{{/each}}</dl>{{else}}<p>No records.</p>{{/each}}</section>{{/each}}
