<form class="workspace-card" data-command-form data-command-id="{{command.id}}" data-answer-type="{{command.answer_type}}"><div class="form-grid"><label>Organization ID<input class="form-control" name="org_id" value="{{command.org_id}}"></label><label>User ID<input class="form-control" name="user_id" value="{{command.user_id}}"></label><label>Tab session ID<input class="form-control" name="tab_ses_id" value="{{command.tab_ses_id}}" maxlength="50"></label><label>Selector<input class="form-control" name="selector" value="{{command.selector}}" maxlength="50"></label></div>
<div class="toolbar"><button class="btn btn-primary" type="submit">Execute</button><button class="btn btn-outline-primary" type="button" data-command-format>Format</button><select class="form-select" data-command-language aria-label="Editor language"><option value="javascript">JavaScript</option><option value="html">HTML</option><option value="css">CSS</option><option value="json">JSON</option></select></div>
<label for="command-source">Script</label><textarea id="command-source" name="script" class="form-control command-source" required>{{command.script}}</textarea><div id="command-editor" hidden></div><p data-command-status role="status">{{command.command_status}}</p><pre data-command-answer>{{command.answer}}</pre></form><section class="workspace-card">{{> record}}</section>
