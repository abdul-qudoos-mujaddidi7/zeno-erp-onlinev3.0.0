<section class="access-card">
  <div class="access-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
  <p class="section-label">{{labels.platform}}</p>
  <h1>{{title}}</h1>
  <p class="access-message">{{message}}</p>
  {{#if loginLink}}<a class="btn btn-outline-primary" href="/superadmin/login?lang={{language}}">{{labels.signIn}}</a>{{/if}}
</section>
