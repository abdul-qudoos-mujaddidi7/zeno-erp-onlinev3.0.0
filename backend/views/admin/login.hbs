<section class="access-card" aria-labelledby="login-title">
  <div class="access-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
  <p class="section-label">{{labels.platform}}</p>
  <h1 id="login-title">{{labels.signIn}}</h1>
  <p class="access-message">{{labels.signInDescription}}</p>
  {{#if errorMessage}}<p class="login-error" role="alert">{{errorMessage}}</p>{{/if}}
  <form method="post" action="/superadmin/login?lang={{language}}" class="login-form">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <input type="hidden" name="language" value="{{language}}">
    <div><label for="username">{{labels.username}}</label><input id="username" name="username" type="text" class="form-control" required minlength="3" maxlength="64" autocomplete="username" autocapitalize="none" spellcheck="false" dir="ltr"></div>
    <div><label for="password">{{labels.password}}</label><input id="password" name="password" type="password" class="form-control" required minlength="12" maxlength="72" autocomplete="current-password"></div>
    <button type="submit" class="btn btn-primary">{{labels.signIn}}</button>
  </form>
</section>
