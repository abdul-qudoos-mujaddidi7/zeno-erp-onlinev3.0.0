<section class="page-heading"><p class="section-label">{{labels.platform}}</p><h1>{{labels.organizations}}</h1><p>{{labels.directoryScope}}</p></section>
<section class="workspace-card">
  <form method="get" action="/superadmin/organizations" class="organization-filters">
    <input type="hidden" name="lang" value="{{language}}">
    <div class="search-field"><label for="search">{{labels.searchOrganizations}}</label><input class="form-control" id="search" name="q" type="search" maxlength="120" value="{{filters.q}}"></div>
    <div><label for="type">{{labels.organizationType}}</label><select class="form-select" name="type" id="type">{{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    <div><label for="status">{{labels.status}}</label><select class="form-select" name="status" id="status">{{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    <div><label for="inventory">{{labels.inventoryMethod}}</label><select class="form-select" name="inventory" id="inventory">{{#each inventoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    <div><label for="sort">{{labels.sortBy}}</label><select class="form-select" name="sort" id="sort">{{#each sorts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    <div><label for="direction">{{labels.sortDirection}}</label><select class="form-select" name="dir" id="direction">{{#each directions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    <div><label for="page-size">{{labels.perPage}}</label><select class="form-select" name="pageSize" id="page-size">{{#each pageSizes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></div>
    <div class="filter-actions"><button type="submit" class="btn btn-primary">{{labels.apply}}</button><a class="btn btn-outline-primary" href="/superadmin/organizations?lang={{language}}">{{labels.resetFilters}}</a></div>
  </form>
  <p class="directory-total">{{labels.organizations}}: <strong>{{total}}</strong></p>
  <div class="table-responsive"><table class="table organization-table">
    <caption class="visually-hidden">{{labels.organizations}}</caption>
    <thead><tr><th scope="col">{{labels.identifier}}</th><th scope="col">{{labels.organizationName}}</th><th scope="col">{{labels.organizationType}}</th><th scope="col">{{labels.status}}</th><th scope="col">{{labels.inventoryMethod}}</th><th scope="col">{{labels.actions}}</th></tr></thead>
    <tbody>{{#each rows}}<tr><td>{{id}}</td><th scope="row"><a href="{{detailUrl}}">{{name}}</a><span class="organization-code">{{codeLabel}}</span></th><td>{{typeLabel}}</td><td>{{statusLabel}}</td><td>{{inventory_method}}</td><td><div class="row-actions"><a class="btn btn-outline-primary" href="{{detailUrl}}">{{../labels.details}}</a>{{#if selected}}<span class="selected-label">{{../labels.selected}}</span>{{else}}{{#if ../canSelectOrganization}}<form method="post" action="/superadmin/organizations/select"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><input type="hidden" name="organizationId" value="{{id}}"><button class="btn btn-outline-primary" type="submit">{{../labels.selectOrganization}}</button></form>{{/if}}{{/if}}</div></td></tr>{{else}}<tr><td colspan="6">{{labels.noOrganizations}}</td></tr>{{/each}}</tbody>
  </table></div>
  <nav class="directory-pagination" aria-label="{{labels.pagination}}"><span>{{labels.page}} {{page}} / {{totalPages}}</span><div>{{#if previousUrl}}<a class="btn btn-outline-primary" href="{{previousUrl}}">{{labels.previous}}</a>{{/if}}{{#if nextUrl}}<a class="btn btn-outline-primary" href="{{nextUrl}}">{{labels.next}}</a>{{/if}}</div></nav>
</section>
