<aside class="admin-sidebar" id="admin-sidebar" aria-label="{{labels.navigation}}">
  <div class="sidebar-brand">
    <a href="/superadmin" class="brand" dir="ltr">ZENO<span>ERP</span></a>
    <button type="button" class="menu-close" data-sidebar-close aria-label="{{labels.close}}"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
  </div>
  <p class="sidebar-caption">{{labels.platform}}</p>
  <nav><a href="/superadmin" class="sidebar-link {{#if overviewActive}}active{{/if}}" {{#if overviewActive}}aria-current="page"{{/if}}><i class="bi bi-grid-1x2" aria-hidden="true"></i>{{labels.overview}}</a>
    {{#if canReadOrganizations}}<a href="/superadmin/organizations" class="sidebar-link {{#if organizationsActive}}active{{/if}}" {{#if organizationsActive}}aria-current="page"{{/if}}><i class="bi bi-building" aria-hidden="true"></i>{{labels.organizations}}</a>{{/if}}
  </nav>
  <p class="sidebar-section">{{labels.planned}}</p>
  <ul class="sidebar-planned">
    <li>{{labels.subscriptions}}</li><li>{{labels.billing}}</li><li>{{labels.support}}</li>
  </ul>
</aside>
